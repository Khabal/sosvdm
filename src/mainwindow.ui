       <column><property name="text"><string>Valor</string></property></column>
      </widget>
     </widget>
    </item>
   </layout>
  </widget>
  <widget class="QMenuBar" name="menubar">
   <widget class="QMenu" name="menuArchivo">
    <property name="title"><string>&amp;Archivo</string></property>
    <addaction name="actionOpen"/>
    <addaction name="actionClose"/>
    <addaction name="separator"/>
    <addaction name="actionPrintImage"/>
    <addaction name="actionPrintMetadata"/>
    <addaction name="actionExportMetadata"/>
