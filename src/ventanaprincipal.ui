<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>VentanaPrincipal</class>
 <widget class="QMainWindow" name="VentanaPrincipal">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1200</width><height>800</height></rect>
  </property>
  <property name="windowTitle"><string>Sólo otro simple visor de metadatos</string></property>
  <widget class="QWidget" name="widgetCentral">
   <layout class="QHBoxLayout" name="disposicionHorizontal">
    <item>
     <widget class="QSplitter" name="divisor">
      <property name="orientation"><enum>Qt::Horizontal</enum></property>
      <widget class="VistaGraficaNivelAmpliacion" name="vistaGrafica"/>
      <widget class="QTreeWidget" name="arbolMetadatos">
       <column><property name="text"><string>Propiedad</string></property></column>
       <column><property name="text"><string>Valor</string></property></column>
      </widget>
     </widget>
    </item>
   </layout>
  </widget>
  <widget class="QMenuBar" name="barraMenus">
   <widget class="QMenu" name="menuArchivo">
    <property name="title"><string>&amp;Archivo</string></property>
    <addaction name="accionAbrir"/>
    <addaction name="accionCerrar"/>
    <addaction name="separator"/>
    <addaction name="accionImprimirImagen"/>
    <addaction name="accionImprimirMetadatos"/>
    <addaction name="accionExportarMetadatos"/>
    <addaction name="separator"/>
    <addaction name="accionSalir"/>
   </widget>
   <widget class="QMenu" name="menuVisualizacion">
    <property name="title"><string>&amp;Visualización</string></property>
    <addaction name="accionSiguienteImagen"/>
    <addaction name="accionImagenAnterior"/>
    <addaction name="separator"/>
    <addaction name="accionAcercar"/>
    <addaction name="accionAlejar"/>
    <addaction name="accionAjustarVentana"/>
    <addaction name="separator"/>
    <addaction name="accionRotarDerecha"/>
    <addaction name="accionRotarIzquierda"/>
    <addaction name="separator"/>
    <addaction name="accionPantallaCompleta"/>
    <addaction name="accionPresentacion"/>
    <addaction name="separator"/>
    <addaction name="accionAlternarMetadatos"/>
   </widget>
   <widget class="QMenu" name="menuAyuda">
    <property name="title"><string>A&amp;yuda</string></property>
    <addaction name="accionAtajos"/>
    <addaction name="accionAcercaDe"/>
   </widget>
   <addaction name="menuArchivo"/>
   <addaction name="menuVisualizacion"/>
   <addaction name="menuAyuda"/>
  </widget>
  <widget class="QToolBar" name="barraHerramientas">
   <property name="windowTitle"><string>Barra de herramientas</string></property>
   <attribute name="toolBarArea"><enum>TopToolBarArea</enum></attribute>
   <attribute name="toolBarBreak"><bool>false</bool></attribute>
  </widget>
  <widget class="QStatusBar" name="barraEstado"/>

  <!-- ============ Acciones del menú Archivo ============ -->
  <action name="accionAbrir">
   <property name="text"><string>&amp;Abrir...</string></property>
   <property name="shortcut"><string>Ctrl+O</string></property>
  </action>
  <action name="accionCerrar">
   <property name="text"><string>&amp;Cerrar</string></property>
   <property name="shortcut"><string>Ctrl+W</string></property>
  </action>
  <action name="accionSalir">
   <property name="text"><string>&amp;Salir</string></property>
   <property name="shortcut"><string>Ctrl+Q</string></property>
  </action>
  <action name="accionImprimirImagen">
   <property name="text"><string>&amp;Imprimir imagen...</string></property>
   <property name="enabled"><bool>false</bool></property>
  </action>
  <action name="accionImprimirMetadatos">
   <property name="text"><string>Imprimir &amp;metadatos...</string></property>
   <property name="enabled"><bool>false</bool></property>
  </action>
  <action name="accionExportarMetadatos">
   <property name="text"><string>&amp;Exportar metadatos...</string></property>
   <property name="shortcut"><string>Ctrl+E</string></property>
   <property name="enabled"><bool>false</bool></property>
   <property name="toolTip"><string>Guardar los metadatos de la imagen actual en un archivo de texto</string></property>
  </action>

  <!-- ============ Acciones del menú Visualización ============ -->
  <action name="accionSiguienteImagen">
   <property name="text"><string>Imagen &amp;siguiente</string></property>
   <property name="shortcut"><string>Space</string></property>
  </action>
  <action name="accionImagenAnterior">
   <property name="text"><string>Imagen &amp;anterior</string></property>
   <property name="shortcut"><string>Backspace</string></property>
  </action>
  <action name="accionAcercar">
   <property name="text"><string>&amp;Acercar</string></property>
  </action>
  <action name="accionAlejar">
   <property name="text"><string>&amp;Alejar</string></property>
  </action>
  <action name="accionAjustarVentana">
   <property name="text"><string>&amp;Ajustar a ventana</string></property>
   <property name="shortcut"><string>Ctrl+0</string></property>
  </action>
  <action name="accionRotarDerecha">
   <property name="text"><string>Rotar 90º a la &amp;derecha</string></property>
   <property name="shortcut"><string>R</string></property>
  </action>
  <action name="accionRotarIzquierda">
   <property name="text"><string>Rotar 90º a la &amp;izquierda</string></property>
   <property name="shortcut"><string>Shift+R</string></property>
  </action>
  <action name="accionPantallaCompleta">
   <property name="text"><string>Modo &amp;pantalla completa</string></property>
   <property name="shortcut"><string>F11</string></property>
  </action>
  <action name="accionPresentacion">
   <property name="text"><string>Modo prese&amp;ntación</string></property>
   <property name="shortcut"><string>F5</string></property>
   <property name="checkable"><bool>true</bool></property>
  </action>
  <action name="accionAlternarMetadatos">
   <property name="text"><string>Mostrar &amp;metadatos</string></property>
   <property name="shortcut"><string>M</string></property>
   <property name="checkable"><bool>true</bool></property>
   <property name="checked"><bool>true</bool></property>
  </action>

  <!-- ============ Acciones del menú Ayuda ============ -->
  <action name="accionAtajos">
   <property name="text"><string>&amp;Atajos de teclado</string></property>
   <property name="shortcut"><string>F1</string></property>
  </action>
  <action name="accionAcercaDe">
   <property name="text"><string>Acerca de...</string></property>
  </action>
 </widget>
 <resources/>
 <connections/>
 <customwidgets>
  <customwidget>
   <class>VistaGraficaNivelAmpliacion</class>
   <extends>QGraphicsView</extends>
   <header>vistagraficanivelampliacion.h</header>
  </customwidget>
 </customwidgets>
